# Copy to ci/.env and fill in. ci/.env is gitignored — never commit
# the real token.
#
# GITHUB_PAT: a GitHub Personal Access Token used once at container
# start to mint a short-lived runner registration token.
#   - Classic PAT: needs the `repo` scope.
#   - Fine-grained PAT: needs Administration: Read and write on the
#     zserio-c-shadow repository.
# Generate at: GitHub -> Settings -> Developer settings -> Tokens.
GITHUB_PAT=ghp_replace_me

# Repository the runners attach to, as owner/name.
GITHUB_REPO=ke-fritz/zserio-c-shadow

# Optional: extra runner labels (comma-separated) appended to the
# always-on `self-hosted,linux,x64` baseline. Used to route specific
# jobs to specific hosts.
#
# - On the primary perf box (the AMD 16c/128G server):
#     RUNNER_LABELS=perf,primary
#   The `perf` job's `runs-on: [self-hosted, perf, primary]` then
#   routes here. Other hosts get their own host-tag in place of
#   `primary` (e.g. `perf,pi5` / `perf,macmini` / `perf,jetson`).
# - On a non-perf box (CI-only runner), leave unset.
#
# See docs/benchmarks/methodology.md for the multi-host policy.
#RUNNER_LABELS=perf,primary

# Upstream zserio benchmark: addressbook. Schema and dataset both
# come from upstream. The decode benchmark runs against a blob
# produced by zserio::serializeToFile from the dataset's JSON; the
# bootstrap.cpp tool in this directory does that conversion once
# at harness setup time. Sourced by run_benchmark.sh.
schema_dir=third_party/zserio/benchmarks/addressbook
entry=addressbook.zs
bootstrap_json=third_party/zserio-benchmarks-datasets/addressbook/addressbook.json
bootstrap_root_type=addressbook::AddressBook
# -withTypeInfoCode lets cpp's `fromJsonFile<T>` reach `T::typeInfo()`
# for reflection-driven JSON parsing. Our C generator doesn't emit
# reflection (REQ-FS-008) and is expected to ignore the flag.
extra_codegen_args="-withTypeInfoCode -withReflectionCode"

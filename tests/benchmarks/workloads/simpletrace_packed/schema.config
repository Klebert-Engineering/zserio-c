# Upstream zserio benchmark: simpletrace_packed. Same logical data as simpletrace
# but with the packed-encoding variant — exercises a different
# wire-format path through the runtime (alignment fast paths for
# _align, delta-coded arrays for _packed).
schema_dir=third_party/zserio/benchmarks/simpletrace
entry=simpletrace_packed.zs
bootstrap_json=third_party/zserio-benchmarks-datasets/simpletrace/prague-groebenzell.json
bootstrap_root_type=simpletrace_packed::SimpleTrace
extra_codegen_args="-withTypeInfoCode -withReflectionCode"

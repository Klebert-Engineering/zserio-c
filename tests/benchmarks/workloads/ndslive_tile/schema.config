# Multi-file schema. Both fields are paths/names relative to REPO_ROOT
# and the staging directory respectively. Sourced by run_benchmark.sh.
schema_dir=conformance/ndslive/zs
entry=all.zs
# The NDS Live schema's `system` package collides with libc's
# system() function in cpp output. Remap the whole namespace under
# `nds.` to dodge the collision, matching what the conformance
# cpp_oracle does.
extra_codegen_args="-setTopLevelPackage nds"

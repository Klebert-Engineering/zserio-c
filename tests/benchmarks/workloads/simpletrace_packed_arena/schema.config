# Arena-allocator showcase, packed-delta variant: same schema and blob
# as simpletrace_packed, but the c_driver uses the runtime's reference
# bump arena and the cpp_driver uses
# `std::pmr::PropagatingPolymorphicAllocator` (upstream's
# `-setCppAllocator polymorphic` mode). Pairs with
# `addressbook_align_arena` to show the arena story spans both
# string-heavy and packed-delta payloads. See
# `docs/benchmarks/methodology.md` § Allocator choice in the perf
# gate for the framing.
schema_dir=third_party/zserio/benchmarks/simpletrace
entry=simpletrace_packed.zs
bootstrap_json=third_party/zserio-benchmarks-datasets/simpletrace/prague-groebenzell.json
bootstrap_root_type=simpletrace_packed::SimpleTrace
extra_codegen_args="-withTypeInfoCode -withReflectionCode -setCppAllocator polymorphic"

# Upstream zserio benchmark: carsales_align. Same logical data as carsales
# but with the align-encoding variant — exercises a different
# wire-format path through the runtime (alignment fast paths for
# _align, delta-coded arrays for _packed).
schema_dir=third_party/zserio/benchmarks/carsales
entry=carsales_align.zs
bootstrap_json=third_party/zserio-benchmarks-datasets/carsales/carsales.json
bootstrap_root_type=carsales_align::CarSales
extra_codegen_args="-withTypeInfoCode -withReflectionCode"

# Upstream zserio benchmark: addressbook_packed. Same logical data as addressbook
# but with the packed-encoding variant — exercises a different
# wire-format path through the runtime (alignment fast paths for
# _align, delta-coded arrays for _packed).
schema_dir=third_party/zserio/benchmarks/addressbook
entry=addressbook_packed.zs
bootstrap_json=third_party/zserio-benchmarks-datasets/addressbook/addressbook.json
bootstrap_root_type=addressbook_packed::AddressBook
extra_codegen_args="-withTypeInfoCode -withReflectionCode"

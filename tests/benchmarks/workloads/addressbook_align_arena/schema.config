# Arena-allocator showcase: same schema/blob as addressbook_align,
# but the c_driver swaps libc malloc/free for the runtime's
# reference bump arena. Demonstrates the embedded-deployment
# allocation pattern. cpp_driver is unchanged — it still uses cpp's
# default std::allocator, so the cpp/c ratio reported here measures
# arena-vs-std::allocator, not a wire-format advantage. See
# docs/benchmarks/methodology.md.
schema_dir=third_party/zserio/benchmarks/addressbook
entry=addressbook_align.zs
bootstrap_json=third_party/zserio-benchmarks-datasets/addressbook/addressbook.json
bootstrap_root_type=addressbook_align::AddressBook
# `-setCppAllocator polymorphic` makes upstream's cpp generator emit
# templated structs that accept `std::pmr::polymorphic_allocator` —
# the fair counterpart to our reference bump arena. Without this
# flag the cpp_driver is hardwired to `std::allocator<uint8_t>` and
# the arena/cpp comparison is asymmetric.
extra_codegen_args="-withTypeInfoCode -withReflectionCode -setCppAllocator polymorphic"

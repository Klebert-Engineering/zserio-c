# Self-hosted CI runner secrets — the PAT lives here, never commit it.
ci/.env

# These paths are populated by the private NDS.Live conformance
# overlay (a companion repository that checks out on top of this
# tree); its extract.sh stages them from external assets. We never
# ship the multi-MB zserio-generated C++ reference or the fixture
# binaries.
conformance/.staging/
conformance/ndslive/zs/
conformance/ndslive/cpp/
conformance/ndslive/tile.bin
conformance/ndslive/tile.yaml

# Fuzz corpus is built up by libFuzzer across CI runs; the actions/cache
# entry in the `fuzz` job is the authoritative store.
tests/fuzz/corpus/

__pycache__/

# Local AI-tooling settings — per-developer, never committed.
.claude/

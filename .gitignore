# Conformance corpus is staged from external assets (extract.sh).
# We don't ship the multi-MB zserio-generated C++ reference or the
# fixture binaries in-tree.
conformance/.staging/
conformance/ndslive/zs/
conformance/ndslive/cpp/
conformance/ndslive/tile.bin
conformance/ndslive/tile.yaml

# Fuzz corpus is built up by libFuzzer across CI runs; the actions/cache
# entry in the `fuzz` job is the authoritative store.
tests/fuzz/corpus/


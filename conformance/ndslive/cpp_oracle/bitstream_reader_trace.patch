+/*
+ * zserio-c oracle hook: per-primitive-read trace. Enabled when
+ * ZSERIO_TRACE=<path> is set in the environment AND
+ * zsc_trace_set_enabled(true) has been called. Each call to
+ * readBitsImpl emits one line to <path>:
+ *   <pos_after> read <nbits> <value>
+ * with the same format zserio-c's runtime emits. Diff the traces to
+ * localise wire-format divergence between this reference and the
+ * zserio-c reader.
+ */
+namespace
+{
+std::FILE *s_zsc_trace = nullptr;
+bool s_zsc_trace_inited = false;
+bool s_zsc_trace_enabled = true;
+void zsc_trace_init()
+{
+    if (s_zsc_trace_inited) return;
+    s_zsc_trace_inited = true;
+    const char *path = std::getenv("ZSERIO_TRACE");
+    if (path && *path) {
+        s_zsc_trace = std::fopen(path, "w");
+    }
+}
+inline void zsc_trace(const char *op, unsigned nbits, std::size_t pos_after, unsigned long long value)
+{
+    if (!s_zsc_trace_inited) zsc_trace_init();
+    if (s_zsc_trace && s_zsc_trace_enabled) {
+        std::fprintf(s_zsc_trace, "%zu %s %u %llu\n", pos_after, op, nbits, value);
+    }
+}
+} // anonymous
+
+extern "C" void zsc_trace_set_enabled(bool enabled)
+{
+    s_zsc_trace_enabled = enabled;
+}
+
 namespace zserio
